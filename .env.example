# ============================================================
# VARIABLES DE ENTORNO — Canal de Denuncias ARH
# ============================================================
# Copia este archivo a .env.local y completa los valores.
# NUNCA subas .env.local al repositorio.
# ============================================================

# --- Email (Gmail SMTP) ---
EMAIL_USER=               # tu-correo@gmail.com
EMAIL_PASS=               # App Password de Gmail (no tu contraseña normal)

# --- Neon PostgreSQL ---
DATABASE_URL=             # postgresql://user:pass@host/db?sslmode=require  (pooled)
DATABASE_URL_UNPOOLED=    # postgresql://user:pass@host/db?sslmode=require  (directo, para scripts)

# --- JWT Admin ---
JWT_SECRET=               # Cadena aleatoria larga (mínimo 32 caracteres)

# --- Google Drive (Storage) ---
GOOGLE_CLIENT_ID=         # OAuth 2.0 Client ID (Google Cloud Console)
GOOGLE_CLIENT_SECRET=     # OAuth 2.0 Client Secret — SECRETO, nunca en frontend
GOOGLE_REDIRECT_URI=      # https://denunciasarhconsultores.netlify.app/.netlify/functions/google-oauth-callback
GOOGLE_REFRESH_TOKEN=     # Obtenido tras el flujo OAuth en /api/google-oauth — SECRETO CRÍTICO
GOOGLE_DRIVE_ROOT_FOLDER_ID= # ID de la carpeta Canal-Denuncias-ARH en Drive (obtenido de la URL)

# ============================================================
# OBSOLETAS — Solo para referencia histórica, ya no se usan
# ============================================================
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
